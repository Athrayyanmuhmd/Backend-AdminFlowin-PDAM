{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "1 0 1 * *"
    },
    {
      "path": "/api/cron/overdue",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/reminder",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/iot-sync",
      "schedule": "0 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "https://aqualink-admin-panel.vercel.app",
        "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, x-internal-secret, apollo-require-preflight",
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Max-Age": "86400"
      },
      "status": 200
    },
    {
      "src": "/(.*)",
      "dest": "/server.ts"
    }
  ]
}
